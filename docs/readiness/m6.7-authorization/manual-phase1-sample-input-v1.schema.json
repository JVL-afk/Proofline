{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opintel:m6.7:manual-phase1-sample-input-v1",
  "title": "Owner-curated Phase 1 manual sample input",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "schema_version", "sample_source", "automated_tdlr_discovery_validated", "candidates"],
  "properties": {
    "record_type": {"const": "M67_MANUAL_PHASE1_SAMPLE_INPUT"},
    "schema_version": {"const": "1.0.0"},
    "sample_source": {"const": "OWNER_CURATED_TDLR_NON_CHERRY_PICKED"},
    "automated_tdlr_discovery_validated": {"const": false},
    "candidates": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["submission_index", "public_business_name", "texas_city_or_service_area", "tdlr_reference", "candidate_hostname"],
        "properties": {
          "submission_index": {"type": "integer", "minimum": 1, "maximum": 24},
          "public_business_name": {"type": "string", "minLength": 1, "maxLength": 200},
          "texas_city_or_service_area": {"type": "string", "minLength": 1, "maxLength": 120},
          "tdlr_reference": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["dataset_id", "license_number", "source_record_locator"],
                "properties": {
                  "dataset_id": {"const": "7358-krk7"},
                  "license_number": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._/-]+$"},
                  "source_record_locator": {"type": "string", "minLength": 1, "maxLength": 512}
                }
              }
            ]
          },
          "candidate_hostname": {
            "type": "string",
            "minLength": 4,
            "maxLength": 253,
            "pattern": "^(?=.{1,253}$)(?!.*\\.\\.)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])$"
          }
        }
      }
    }
  }
}
