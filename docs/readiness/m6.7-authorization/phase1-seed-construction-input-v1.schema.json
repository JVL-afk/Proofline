{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/m6.7/phase1-seed-construction-input-v1.json",
  "title": "Phase 1 provenance-backed business-only seed construction input",
  "type": "array",
  "minItems": 24,
  "maxItems": 100,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "public_business_name",
      "first_party_host_candidate",
      "organization_group_hint",
      "lead_flow_unit_hint",
      "eligibility_observations",
      "provenance"
    ],
    "properties": {
      "public_business_name": {"type": "string", "minLength": 1},
      "public_business_aliases": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      },
      "texas_city_or_service_area": {"type": ["string", "null"]},
      "first_party_host_candidate": {
        "type": "string",
        "pattern": "^[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
      },
      "organization_group_hint": {"type": "string", "minLength": 1},
      "franchise_or_shared_brand_hint": {"type": ["string", "null"]},
      "lead_flow_unit_hint": {"type": "string", "minLength": 1},
      "distinct_lead_flow_observations": {
        "type": "array",
        "items": {"type": "string", "minLength": 1}
      },
      "identity_ambiguous": {"type": "boolean"},
      "explicit_ineligibility_reason": {
        "enum": [
          "OUTSIDE_TEXAS",
          "NOT_COMMERCIAL_HVAC",
          "NOT_B2B",
          "CLOSED_OR_INACTIVE",
          "NO_PERMITTED_FIRST_PARTY_HOST"
        ]
      },
      "eligibility_observations": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "texas",
          "commercial_hvac",
          "b2b",
          "operational",
          "first_party_host"
        ],
        "properties": {
          "identity": {"$ref": "#/$defs/businessEvidence"},
          "texas": {"$ref": "#/$defs/businessEvidence"},
          "commercial_hvac": {"$ref": "#/$defs/businessEvidence"},
          "b2b": {"$ref": "#/$defs/businessEvidence"},
          "operational": {"$ref": "#/$defs/businessEvidence"},
          "first_party_host": {"$ref": "#/$defs/businessEvidence"}
        }
      },
      "provenance": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "source_artifact_ref",
            "source_artifact_sha256",
            "locator",
            "observed_at"
          ],
          "properties": {
            "source_id": {"type": "string", "minLength": 1},
            "source_artifact_ref": {"type": "string", "minLength": 1},
            "source_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "locator": {"type": "string", "minLength": 1},
            "observed_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    }
  },
  "$defs": {
    "businessEvidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
