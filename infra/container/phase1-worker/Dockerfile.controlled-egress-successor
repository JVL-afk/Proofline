ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.base.digest="sha256:855003aec9cbe6d0e38416f8b5ee44baacd2d2a34d752dfefd2e110246561a79" \
      org.opencontainers.image.title="M6.7 Phase 1 bounded controlled-egress successor"

COPY packages/research-local/src/opintel_research_local/egress.py \
     /app/research-local/opintel_research_local/egress.py
COPY packages/research-local/src/opintel_research_local/settings.py \
     /app/research-local/opintel_research_local/settings.py
COPY workers/research/src/opintel_research_worker/authorization.py \
     /app/research-worker/opintel_research_worker/authorization.py
COPY workers/research/src/opintel_research_worker/egress_lease.py \
     /app/research-worker/opintel_research_worker/egress_lease.py
COPY workers/research/src/opintel_research_worker/egress_main.py \
     /app/research-worker/opintel_research_worker/egress_main.py
COPY workers/research/src/opintel_research_worker/main.py \
     /app/research-worker/opintel_research_worker/main.py
COPY workers/intelligence/src/opintel_intelligence_worker/controlled_egress_lifecycle.py \
     /app/intelligence-worker/opintel_intelligence_worker/controlled_egress_lifecycle.py
COPY workers/intelligence/src/opintel_intelligence_worker/execution.py \
     /app/intelligence-worker/opintel_intelligence_worker/execution.py
