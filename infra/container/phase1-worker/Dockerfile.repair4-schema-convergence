ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.title="M6.7 Phase 1 Repair 4 schema-convergence completion" \
      org.opencontainers.image.base.digest="sha256:edda5c622fd76f1c7b6449f19ed562fd823dabd05882f123df238b695983cc88"

COPY workers/intelligence/src/opintel_intelligence_worker/coordinator_persistence.py /app/intelligence-worker/opintel_intelligence_worker/coordinator_persistence.py
